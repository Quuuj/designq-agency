# 실제 값은 .env 에 넣고 절대 커밋하지 마세요.
# Vercel 배포 시에는 대시보드 > Settings > Environment Variables 에 추가(Production 체크).

# OpenAI (챗봇 응답 + 임베딩)
OPENAI_API_KEY=sk-여기에-키-입력

# Supabase (RAG documents / leads / chat_logs)
# service_role 키는 서버 전용 — 클라이언트에 절대 노출 금지!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
